@model TaskWeb.Models.Materia
@using TaskWeb.Models

@{
    var turmas = ViewBag.Turmas as List<Turma> ?? new List<Turma>();
    var professores = ViewBag.Professores as List<Professor> ?? new List<Professor>();
    ViewData["Title"] = "Nova Matéria";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet" />
    <style>
        .form-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            border-top: 5px solid #8b5cf6; /* Roxo */
        }
        .icon-header {
            width: 60px;
            height: 60px;
            background-color: #f5f3ff;
            color: #8b5cf6;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin: 0 auto 1.5rem auto;
        }
    </style>
</head>
<body class="bg-light">
    
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h4 fw-bold text-dark mb-0">Nova Matéria</h1>
                    <a href="/materias" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Voltar
                    </a>
                </div>

                <div class="card form-card p-4">
                    <div class="card-body">
                        
                        <div class="text-center mb-4">
                            <div class="icon-header">
                                <i class="bi bi-journal-plus"></i>
                            </div>
                            <h5 class="fw-bold">Cadastrar Disciplina</h5>
                            <p class="text-muted small">Preencha os dados e vincule ao professor.</p>
                        </div>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center rounded-3 mb-4">
                                <i class="bi bi-exclamation-circle-fill me-2"></i>
                                <div>@ViewBag.Error</div>
                            </div>
                        }

                        <form action="/materias/create" method="POST">
                            
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <div class="form-floating mb-3">
                                        <input name="Nome" class="form-control" id="nomeInput" placeholder="Ex: Matemática" value="@Model.Nome" required />
                                        <label for="nomeInput">Nome da Disciplina</label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-floating mb-3">
                                        <input name="CargaHorariaSemanal" type="number" min="1" max="10" class="form-control" id="cargaInput" placeholder="4" value="@Model.CargaHorariaSemanal" required />
                                        <label for="cargaInput">Aulas/Semana</label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-floating mb-3">
                                <select name="TurmaId" class="form-select" id="turmaSelect" required>
                                    <option value="">Selecione a turma...</option>
                                    @foreach (var turma in turmas)
                                    {
                                        <option value="@turma.TurmaId" selected="@(turma.TurmaId == Model.TurmaId)">@turma.Nome</option>
                                    }
                                </select>
                                <label for="turmaSelect">Turma</label>
                            </div>

                            <div class="form-floating mb-4">
                                <select name="ProfessorId" class="form-select" id="profSelect" required>
                                    <option value="">Selecione o professor...</option>
                                    @foreach (var professor in professores)
                                    {
                                        <option value="@professor.ProfessorId" selected="@(professor.ProfessorId == Model.ProfessorId)">@professor.Nome</option>
                                    }
                                </select>
                                <label for="profSelect">Professor Responsável</label>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-semibold" style="background-color: #8b5cf6; border-color: #8b5cf6;">
                                    <i class="bi bi-check2-circle me-2"></i>Salvar Matéria
                                </button>
                                <a href="/materias" class="btn btn-light text-muted fw-semibold mt-2">Cancelar</a>
                            </div>
                        </form>

                    </div>
                </div>

            </div>
        </div>
    </div>
    
</body>
</html>