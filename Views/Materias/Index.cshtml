@model List<TaskWeb.Models.Materia>

@{
    ViewData["Title"] = "Matérias";
    var nomeUsuario = Context.Session.GetString("Nome") ?? "Usuário";
    var primeiroNome = nomeUsuario.Split(' ')[0];
    
    string GetCargaColor(int carga) {
        if (carga >= 4) return "danger";
        if (carga >= 3) return "warning";
        return "success";
    }
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet" />
    <style>
        /* Header Global */
        .navbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.75rem 0;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .navbar-brand {
            font-weight: 700;
            color: #4f46e5 !important;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        /* Matéria Card */
        .card-materia {
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            transition: all 0.3s ease;
            position: relative;
            background: white;
            border-top: 4px solid #8b5cf6;
        }
        
        .card-materia:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }

        .icon-materia {
            width: 48px;
            height: 48px;
            background-color: #f5f3ff;
            color: #8b5cf6;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-right: 1rem;
        }

        .info-row {
            display: flex;
            align-items: center;
            font-size: 0.9rem;
            color: #64748b;
            margin-bottom: 0.5rem;
        }
        .info-row i {
            width: 24px;
            text-align: center;
            margin-right: 8px;
            color: #94a3b8;
        }
    </style>
</head>
<body class="bg-light">
    
    <nav class="navbar sticky-top mb-5">
        <div class="container">
            <a class="navbar-brand" href="/home">
                <i class="bi bi-grid-1x2-fill"></i>
                Sistema de Grade
            </a>
            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-sm-block text-muted small">
                    Olá, <strong>@primeiroNome</strong>
                </div>
                <a href="/usuario/logout" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Sair</a>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Matérias Curriculares</h1>
                <p class="text-muted mb-0">Disciplinas cadastradas e atribuição de professores.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/home" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Voltar
                </a>
                <a href="/materias/create" class="btn btn-primary" style="background-color: #8b5cf6; border-color: #8b5cf6;">
                    <i class="bi bi-plus-lg me-1"></i> Nova Matéria
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success d-flex align-items-center shadow-sm border-0 mb-4 rounded-3">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i> <div>@TempData["Success"]</div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center shadow-sm border-0 mb-4 rounded-3">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> <div>@TempData["Error"]</div>
            </div>
        }

        @if (Model.Count == 0)
        {
             <div class="text-center py-5">
                <div class="bg-white p-4 rounded-circle shadow-sm d-inline-block mb-3">
                    <i class="bi bi-journal-bookmark fs-1 text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark">Nenhuma matéria cadastrada</h5>
                <a href="/materias/create" class="btn btn-primary mt-2" style="background-color: #8b5cf6; border-color: #8b5cf6;">Cadastrar Agora</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var materia in Model)
                {
                    <div class="col">
                        <div class="card card-materia h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-start mb-4">
                                    <div class="icon-materia flex-shrink-0">
                                        <i class="bi bi-journal-text"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h5 class="fw-bold text-dark mb-1">@materia.Nome</h5>
                                        <span class="badge bg-@GetCargaColor(materia.CargaHorariaSemanal)-subtle text-@GetCargaColor(materia.CargaHorariaSemanal) border border-@GetCargaColor(materia.CargaHorariaSemanal)">
                                            @materia.CargaHorariaSemanal aulas/semana
                                        </span>
                                    </div>
                                    
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                                            <li><a class="dropdown-item" href="/materias/edit/@materia.MateriaId"><i class="bi bi-pencil me-2"></i>Editar</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" href="/materias/delete/@materia.MateriaId"><i class="bi bi-trash me-2"></i>Excluir</a></li>
                                        </ul>
                                    </div>
                                </div>

                                <div class="bg-light rounded-3 p-3">
                                    <div class="info-row">
                                        <i class="bi bi-people-fill"></i>
                                        <strong class="me-1 text-dark">Turma:</strong> 
                                        <span class="text-truncate">@materia.TurmaNome</span>
                                    </div>
                                    <div class="info-row mb-0">
                                        <i class="bi bi-person-badge-fill"></i>
                                        <strong class="me-1 text-dark">Prof:</strong> 
                                        <span class="text-truncate">@materia.ProfessorNome</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>