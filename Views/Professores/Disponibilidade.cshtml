@using System.Collections.Generic
@model TaskWeb.Models.ProfessorDisponibilidadeViewModel
@{
    ViewData["Title"] = "Agenda do Professor";
    var dias = Model.Dias;
    var slots = Model.Slots;
    var selecionados = Model.Selecionados ?? new Dictionary<int, HashSet<int>>();
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet" />
    <style>
        .agenda-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            overflow: hidden;
        }
        
        .table-agenda th {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #64748b;
            font-weight: 600;
            background-color: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            padding: 1rem;
            text-align: center;
        }

        .slot-info {
            font-weight: 700;
            color: #1e293b;
            font-size: 1.1rem;
            margin-bottom: 0.2rem;
        }
        .slot-time {
            font-size: 0.9rem;
            color: #64748b;
            font-weight: 500;
            display: block;
            margin-bottom: 0.4rem;
        }

        .badge-turno {
            font-size: 0.75rem;
            padding: 0.35em 0.8em;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }
        .badge-manha { background-color: #fff7ed; color: #ea580c; border: 1px solid #ffedd5; }
        .badge-tarde { background-color: #eff6ff; color: #2563eb; border: 1px solid #dbeafe; }
        .badge-noite { background-color: #f5f3ff; color: #7c3aed; border: 1px solid #ede9fe; }

        .btn-check:checked + .btn-outline-primary {
            background-color: #4f46e5;
            border-color: #4f46e5;
            color: white;
            box-shadow: 0 4px 6px rgba(79, 70, 229, 0.3);
        }
        
        .btn-outline-primary {
            border-color: #e2e8f0;
            color: #cbd5e1;
            border-radius: 8px;
            width: 100%;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            background-color: white;
        }
        
        .btn-outline-primary:hover {
            background-color: #f8fafc;
            border-color: #94a3b8;
            color: #64748b;
        }

        .check-icon { font-size: 1.4rem; }
        .btn-check:checked + .btn-outline-primary .check-icon::before {
            content: "\f26a";
        }
    </style>
</head>
<body class="bg-light">

    <div class="container py-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Agenda de Disponibilidade</h1>
                <p class="text-muted mb-0">Defina os horários livres para <strong class="text-primary">@Model.ProfessorNome</strong>.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/professores" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Voltar
                </a>
                <button type="submit" form="formDispo" class="btn btn-success btn-sm px-4 rounded-pill fw-bold">
                    <i class="bi bi-floppy me-1"></i> Salvar Agenda
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(success))
        {
            <div class="alert alert-success d-flex align-items-center shadow-sm border-0 rounded-3 mb-4">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i> <div>@success</div>
            </div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger d-flex align-items-center shadow-sm border-0 rounded-3 mb-4">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> <div>@error</div>
            </div>
        }

        @if (slots.Count == 0)
        {
            <div class="text-center py-5">
                <div class="bg-white p-4 rounded-circle shadow-sm d-inline-block mb-3">
                    <i class="bi bi-calendar-x fs-1 text-warning"></i>
                </div>
                <h5>Sem horários cadastrados</h5>
                <p class="text-muted">É necessário cadastrar os slots de aula no sistema primeiro.</p>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-3 mb-4 p-3">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="small fw-bold text-muted text-uppercase me-2"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Seleção Rápida:</span>
                    
                    <button type="button" class="btn btn-sm btn-light border" onclick="selecionarTudo()">
                        Todos
                    </button>
                    <button type="button" class="btn btn-sm btn-light border" onclick="selecionarTurno('Manha')">
                        Manhã Completa
                    </button>
                    <button type="button" class="btn btn-sm btn-light border" onclick="selecionarTurno('Tarde')">
                        Tarde Completa
                    </button>
                    <div class="vr mx-1"></div>
                    <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="limparTudo()">
                        <i class="bi bi-x-circle me-1"></i> Limpar
                    </button>
                </div>
            </div>

            <form id="formDispo" action="/professores/disponibilidade" method="POST">
                <input type="hidden" name="ProfessorId" value="@Model.ProfessorId" />
                
                <div class="card agenda-card">
                    <div class="table-responsive">
                        <table class="table table-agenda mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th class="text-start ps-4" style="width: 250px;">Horário da Aula</th>
                                    @foreach (var dia in dias)
                                    {
                                        <th>@dia.Nome</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var slot in slots)
                                {
                                    var turnoNormalizado = slot.TurnoNome.Replace("ã", "a").Replace("Manhã", "Manha");
                                    var badgeClass = turnoNormalizado.Contains("Manha") ? "badge-manha" : "badge-tarde";

                                    <tr class="row-hover">
                                        <td class="text-start ps-4 border-end bg-light-subtle">
                                            <div class="d-flex flex-column py-2">
                                                <span class="badge @badgeClass badge-turno w-auto align-self-start mb-2">@slot.TurnoNome</span>
                                                <span class="slot-info">Aula @slot.Sequencia</span>
                                                <div class="d-flex align-items-center text-muted">
                                                    <i class="bi bi-clock me-1 small"></i>
                                                    <span class="slot-time mb-0">
                                                        @slot.HoraInicio.ToString("hh\\:mm") - @slot.HoraFim.ToString("hh\\:mm")
                                                    </span>
                                                </div>
                                            </div>
                                        </td>

                                        @foreach (var dia in dias)
                                        {
                                            bool marcado = selecionados.ContainsKey(dia.Valor) && selecionados[dia.Valor].Contains(slot.SlotAulaId);
                                            string inputId = $"chk_{dia.Valor}_{slot.SlotAulaId}";
                                            
                                            <td class="p-2 text-center">
                                                <input type="checkbox" 
                                                       class="btn-check chk-dispo" 
                                                       data-turno="@turnoNormalizado"
                                                       id="@inputId" 
                                                       name="Selecionados" 
                                                       value="@(dia.Valor):@(slot.SlotAulaId)" 
                                                       autocomplete="off"
                                                       @(marcado ? "checked" : "") />
                                                
                                                <label class="btn btn-outline-primary border-0 shadow-sm" for="@inputId">
                                                    <i class="bi bi-circle check-icon"></i>
                                                </label>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </form>
        }
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function selecionarTudo() {
            document.querySelectorAll('.chk-dispo').forEach(chk => chk.checked = true);
        }

        function limparTudo() {
            document.querySelectorAll('.chk-dispo').forEach(chk => chk.checked = false);
        }

        function selecionarTurno(turnoNome) {
            document.querySelectorAll(`.chk-dispo[data-turno*='${turnoNome}']`).forEach(chk => {
                chk.checked = true;
            });
        }
    </script>
</body>
</html>