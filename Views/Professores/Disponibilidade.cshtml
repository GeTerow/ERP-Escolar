@using System.Collections.Generic
@model TaskWeb.Models.ProfessorDisponibilidadeViewModel
@{
    var dias = Model.Dias;
    var slots = Model.Slots;
    var selecionados = Model.Selecionados ?? new Dictionary<int, HashSet<int>>();
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}

<html>
    <head>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
        <link href="/css/app.css" rel="stylesheet" />
    </head>
    <body class="bg-light">
        <div class="container py-4">
            <div class="card shadow-sm page-card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h1 class="h5 mb-0">Disponibilidade do professor</h1>
                        <small class="text-muted">@Model.ProfessorNome</small>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-outline-secondary btn-sm" href="/professores"><i class="bi bi-arrow-left"></i> Voltar</a>
                    </div>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(success))
                    {
                        <div class="alert alert-success">@success</div>
                    }
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger">@error</div>
                    }

                    @if (slots.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">Cadastre slots de aula para definir restricoes.</div>
                    }
                    else
                    {
                        <form action="/professores/disponibilidade" method="POST" class="d-flex flex-column gap-3">
                            <input type="hidden" name="ProfessorId" value="@Model.ProfessorId" />
                            <div class="alert alert-info">
                                Marque os horarios em que o professor pode dar aula. Deixe vazio para indicar que nao ha restricao.
                            </div>
                            <div class="border rounded">
                                <div class="table-responsive">
                                    <table class="table table-bordered align-middle mb-0 text-center">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="width: 20%;">Horario</th>
                                                @foreach (var dia in dias)
                                                {
                                                    <th>@dia.Nome</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var slot in slots)
                                            {
                                                <tr>
                                                    <td class="text-start">
                                                        <div class="fw-semibold">@slot.TurnoNome - Aula @slot.Sequencia</div>
                                                        <small class="text-muted">@slot.HoraInicio.ToString("hh\\:mm") - @slot.HoraFim.ToString("hh\\:mm")</small>
                                                    </td>
                                                    @foreach (var dia in dias)
                                                    {
                                                        bool marcado = selecionados.ContainsKey(dia.Valor) && selecionados[dia.Valor].Contains(slot.SlotAulaId);
                                                        <td>
                                                            <input type="checkbox" class="form-check-input" name="Selecionados" value="@(dia.Valor):@(slot.SlotAulaId)" @(marcado ? "checked" : string.Empty) />
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div>
                                <button class="btn btn-success"><i class="bi bi-floppy me-1"></i>Salvar disponibilidade</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </body>
</html>

