@model List<TaskWeb.Models.Professor>

@{
    ViewData["Title"] = "Professores";
    var nomeUsuario = Context.Session.GetString("Nome") ?? "Usuário";
    var primeiroNome = nomeUsuario.Split(' ')[0];
    
    string GetIniciais(string nome) {
        if (string.IsNullOrWhiteSpace(nome)) return "?";
        var parts = nome.Trim().Split(' ');
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper();
    }
    
    string GetColorClass(int id) {
        var colors = new[] { "indigo", "pink", "teal", "orange", "blue", "purple" };
        return colors[id % colors.Length];
    }
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Professores - Sistema de Grade</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-light: #f8fafc;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --card-border: #e2e8f0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            padding-bottom: 40px;
        }

        .navbar {
            background-color: #ffffff;
            border-bottom: 1px solid var(--card-border);
            padding: 0.75rem 0;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        
        .navbar-brand {
            font-weight: 700;
            color: #4f46e5 !important;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .card-prof {
            background: white;
            border: 1px solid var(--card-border);
            border-radius: 16px;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            border-top-width: 4px; 
            border-top-style: solid;
        }

        .card-prof:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
        }

        .avatar-box {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 600;
            margin: 0 auto 1rem auto;
            color: white;
            border: 4px solid white;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        .contact-list {
            list-style: none;
            padding: 0;
            margin: 0 0 1.5rem 0;
            text-align: left;
        }
        .contact-list li {
            display: flex;
            align-items: center;
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            padding: 0.5rem;
            border-radius: 6px;
            transition: background 0.2s;
        }
        .contact-list li:hover {
            background-color: #f1f5f9;
            color: var(--text-dark);
        }
        .contact-list i {
            margin-right: 0.75rem;
            font-size: 1.1rem;
            opacity: 0.8;
        }
        .card-actions {
            background-color: #f8fafc;
            border-top: 1px solid var(--card-border);
            padding: 1rem 1.5rem; 
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .action-icon {
            color: var(--text-muted);
            font-size: 1.1rem;
            padding: 0.4rem;
            border-radius: 6px;
            transition: all 0.2s;
        }
        .action-icon:hover {
            background-color: #e2e8f0;
            color: var(--text-dark);
        }
        .action-icon.delete:hover {
            background-color: #fef2f2;
            color: #ef4444;
        }

        .theme-indigo { border-top-color: #6366f1; } .theme-indigo .avatar-box { background-color: #6366f1; } .theme-indigo i { color: #6366f1; }
        .theme-pink { border-top-color: #ec4899; } .theme-pink .avatar-box { background-color: #ec4899; } .theme-pink i { color: #ec4899; }
        .theme-teal { border-top-color: #14b8a6; } .theme-teal .avatar-box { background-color: #14b8a6; } .theme-teal i { color: #14b8a6; }
        .theme-orange { border-top-color: #f97316; } .theme-orange .avatar-box { background-color: #f97316; } .theme-orange i { color: #f97316; }
        .theme-blue { border-top-color: #3b82f6; } .theme-blue .avatar-box { background-color: #3b82f6; } .theme-blue i { color: #3b82f6; }
        .theme-purple { border-top-color: #a855f7; } .theme-purple .avatar-box { background-color: #a855f7; } .theme-purple i { color: #a855f7; }

    </style>
</head>
<body>

    <nav class="navbar sticky-top mb-5">
        <div class="container">
            <a class="navbar-brand" href="/home">
                <i class="bi bi-grid-1x2-fill"></i>
                Sistema de Grade
            </a>
            
            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-sm-block text-muted small">
                    Olá, <strong>@primeiroNome</strong>
                </div>
                <a href="/usuario/logout" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    Sair
                </a>
            </div>
        </div>
    </nav>

    <div class="container">
        
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-5">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Equipe Docente</h1>
                <p class="text-muted mb-0">Gerencie os professores e visualize contatos.</p>
            </div>
            <div class="d-flex gap-2 mt-3 mt-sm-0">
                <a href="/home" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Voltar
                </a>
                <a href="/professores/create" class="btn btn-primary">
                    <i class="bi bi-person-plus-fill me-1"></i> Novo Professor
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success d-flex align-items-center shadow-sm border-0 mb-4 rounded-3">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i> <div>@TempData["Success"]</div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center shadow-sm border-0 mb-4 rounded-3">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> <div>@TempData["Error"]</div>
            </div>
        }

        @if (Model.Count == 0)
        {
             <div class="text-center py-5">
                <div class="bg-white d-inline-block p-4 rounded-circle shadow-sm mb-3">
                    <i class="bi bi-person-badge fs-1 text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark">Nenhum professor cadastrado</h5>
                <p class="text-muted">Comece adicionando os membros da sua equipe.</p>
                <a href="/professores/create" class="btn btn-primary mt-2">Cadastrar Agora</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
                @foreach (var prof in Model)
                {
                    var iniciais = GetIniciais(prof.Nome);
                    var tema = "theme-" + GetColorClass(prof.ProfessorId);
                    
                    <div class="col">
                        <div class="card-prof h-100 @tema">
                            <div class="card-body text-center pt-4 px-4 pb-0">
                                
                                <div class="avatar-box">
                                    @iniciais
                                </div>
                                
                                <h5 class="fw-bold text-dark mb-3 text-truncate" title="@prof.Nome">
                                    @prof.Nome
                                </h5>

                                <ul class="contact-list">
                                    <li>
                                        <i class="bi bi-envelope"></i>
                                        <span class="text-truncate">
                                            @(!string.IsNullOrEmpty(prof.Email) ? prof.Email : "Email não informado")
                                        </span>
                                    </li>
                                    <li>
                                        <i class="bi bi-telephone"></i>
                                        <span>
                                            @(!string.IsNullOrEmpty(prof.Telefone) ? prof.Telefone : "Tel. não informado")
                                        </span>
                                    </li>
                                </ul>

                                <div class="mb-4">
                                    <a href="/professores/acessorapido?professorId=@prof.ProfessorId" class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-semibold">
                                        Ver Agenda Completa
                                    </a>
                                </div>
                            </div>

                            <div class="card-actions">
                                <a href="/professores/disponibilidade/@prof.ProfessorId" class="text-decoration-none small fw-bold text-secondary" title="Gerenciar Disponibilidade">
                                    <i class="bi bi-gear-fill me-1"></i> Disponibilidade
                                </a>
                                <div>
                                    <a href="/professores/edit/@prof.ProfessorId" class="action-icon" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="/professores/delete/@prof.ProfessorId" class="action-icon delete" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>