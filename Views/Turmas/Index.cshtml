@model List<TaskWeb.Models.Turma>

@{
    ViewData["Title"] = "Turmas";
    var nomeUsuario = Context.Session.GetString("Nome") ?? "Usuário";
    var primeiroNome = nomeUsuario.Split(' ')[0];
    
    string GetTurnoColor(string turno) {
        if (string.IsNullOrEmpty(turno)) return "secondary";
        return turno.ToLower().Contains("manha") || turno.ToLower().Contains("manhã") ? "warning" : "info";
    }
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet" />
    <style>
        /* Header Style */
        .navbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.75rem 0;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .navbar-brand {
            font-weight: 700;
            color: #4f46e5 !important;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        /* Card Style */
        .card-turma {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            transition: all 0.2s;
            overflow: hidden;
            position: relative;
        }
        .card-turma:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
        }
        .border-left-indicator {
            position: absolute; left: 0; top: 0; bottom: 0; width: 5px;
        }
    </style>
</head>
<body class="bg-light">
    
    <nav class="navbar sticky-top mb-5">
        <div class="container">
            <a class="navbar-brand" href="/home">
                <i class="bi bi-grid-1x2-fill"></i>
                Sistema de Grade
            </a>
            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-sm-block text-muted small">
                    Olá, <strong>@primeiroNome</strong>
                </div>
                <a href="/usuario/logout" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Sair</a>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Turmas</h1>
                <p class="text-muted mb-0">Visualização em grade das turmas cadastradas.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/home" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Voltar
                </a>
                <a href="/turmas/create" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i> Nova Turma
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success d-flex align-items-center shadow-sm border-0 mb-4 rounded-3">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i> <div>@TempData["Success"]</div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center shadow-sm border-0 mb-4 rounded-3">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> <div>@TempData["Error"]</div>
            </div>
        }

        @if (Model.Count == 0)
        {
             <div class="text-center py-5">
                <div class="mb-3">
                    <div class="bg-light d-inline-flex p-4 rounded-circle text-muted">
                        <i class="bi bi-collection fs-1"></i>
                    </div>
                </div>
                <h5 class="fw-bold text-dark">Nenhuma turma encontrada</h5>
                <a href="/turmas/create" class="btn btn-primary mt-3">Cadastrar Turma</a>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var turma in Model)
                {
                    var corTurno = GetTurnoColor(turma.TurnoNome);
                    
                    <div class="col">
                        <div class="card card-turma h-100 bg-white shadow-sm">
                            <div class="border-left-indicator bg-@corTurno"></div>
                            
                            <div class="card-body ps-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1">@turma.Nome</h5>
                                        <span class="badge bg-light text-dark border">@turma.AnoLetivo</span>
                                    </div>
                                    
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                                            <li><a class="dropdown-item" href="/turmas/edit/@turma.TurmaId"><i class="bi bi-pencil me-2"></i>Editar</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item text-danger" href="/turmas/delete/@turma.TurmaId"><i class="bi bi-trash me-2"></i>Excluir</a></li>
                                        </ul>
                                    </div>
                                </div>
                                
                                <div class="d-flex align-items-center text-muted">
                                    <div class="rounded-circle bg-@corTurno bg-opacity-10 p-2 me-2 text-@corTurno">
                                        <i class="bi bi-clock-history"></i>
                                    </div>
                                    <div>
                                        <small class="d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Turno</small>
                                        <span class="fw-medium">@(string.IsNullOrEmpty(turma.TurnoNome) ? "-" : turma.TurnoNome)</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card-footer bg-white border-top-0 pt-0 pb-3 ps-4">
                                <a href="/grade?turmaId=@turma.TurmaId" class="btn btn-sm btn-outline-primary w-100 rounded-pill">
                                    Ver Grade
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>