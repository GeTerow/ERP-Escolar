@{
    var nome = Context.Session.GetString("Nome") ?? "Usuário";
    var primeiroNome = nome.Split(' ')[0];
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Sistema de Grade</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-light: #f8fafc;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --card-border: #e2e8f0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
        }

        .navbar {
            background-color: #ffffff;
            border-bottom: 1px solid var(--card-border);
            padding: 1rem 0;
        }
        
        .navbar-brand {
            font-weight: 700;
            color: #4f46e5 !important;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            letter-spacing: -0.5px;
        }

        .user-pill {
            background-color: #f1f5f9;
            color: var(--text-dark);
            padding: 0.5rem 1.2rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }

        .dashboard-header {
            padding: 3rem 0 2rem 0;
        }
        .welcome-text {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--text-dark);
            letter-spacing: -0.5px;
            margin-bottom: 0.5rem;
        }
        .date-text {
            color: var(--text-muted);
            font-weight: 500;
            font-size: 0.95rem;
        }

        /* CARD BASE */
        .module-card {
            background: white;
            border: 1px solid var(--card-border);
            border-radius: 0.75rem;
            padding: 1.75rem;
            transition: all 0.3s ease;
            height: 100%;
            display: flex;
            flex-direction: column;
            text-decoration: none !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            border-top-width: 4px;
            border-top-style: solid;
        }

        .module-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
            border-top-width: 6px;
        }

        .icon-box {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 0.75rem;
        }

        .card-desc {
            font-size: 0.9rem;
            color: var(--text-muted);
            line-height: 1.6;
            margin-bottom: 2rem;
            flex-grow: 1;
        }

        .card-link-text {
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .module-card:hover .card-link-text i {
            transform: translateX(4px);
            transition: transform 0.2s;
        }

        /* --- TEMAS DE CORES (Borda + Ícone + Texto do Link) --- */

        /* Azul (Turmas) */
        .theme-blue { border-top-color: #3b82f6; }
        .theme-blue .icon-box { background-color: #eff6ff; color: #3b82f6; }
        .theme-blue .card-link-text { color: #3b82f6; }

        /* Indigo (Professores) */
        .theme-indigo { border-top-color: #6366f1; }
        .theme-indigo .icon-box { background-color: #eef2ff; color: #6366f1; }
        .theme-indigo .card-link-text { color: #6366f1; }

        /* Roxo (Matérias) */
        .theme-purple { border-top-color: #8b5cf6; }
        .theme-purple .icon-box { background-color: #f5f3ff; color: #8b5cf6; }
        .theme-purple .card-link-text { color: #8b5cf6; }

        /* Verde (Grade) */
        .theme-green { border-top-color: #22c55e; }
        .theme-green .icon-box { background-color: #f0fdf4; color: #22c55e; }
        .theme-green .card-link-text { color: #22c55e; }

        /* Laranja (Agenda) */
        .theme-orange { border-top-color: #f97316; }
        .theme-orange .icon-box { background-color: #fff7ed; color: #f97316; }
        .theme-orange .card-link-text { color: #f97316; }

        /* Teal (Usuários) */
        .theme-teal { border-top-color: #14b8a6; }
        .theme-teal .icon-box { background-color: #f0fdfa; color: #14b8a6; }
        .theme-teal .card-link-text { color: #14b8a6; }

    </style>
</head>
<body>

    <nav class="navbar sticky-top">
        <div class="container">
            <a class="navbar-brand" href="#">
                <i class="bi bi-grid-1x2-fill"></i>
                Sistema de Grade
            </a>
            
            <div class="d-flex align-items-center gap-3">
                <div class="user-pill d-none d-sm-flex">
                    <span class="text-muted small fw-normal">Usuário:</span>
                    @primeiroNome
                </div>
                <a href="/usuario/logout" class="btn btn-outline-secondary btn-sm px-3 rounded-3">
                    Sair
                </a>
            </div>
        </div>
    </nav>

    <div class="container dashboard-header">
        <div class="row">
            <div class="col-12">
                <h1 class="welcome-text">Olá, @primeiroNome</h1>
                <p class="date-text">
                    @DateTime.Now.ToString("dd 'de' MMMM, dddd")
                </p>
            </div>
        </div>
    </div>

    <div class="container pb-5">
        <div class="row g-4">
            
            <div class="col-md-6 col-lg-4 col-xl-3">
                <a href="/turmas" class="module-card theme-blue">
                    <div class="icon-box">
                        <i class="bi bi-collection"></i>
                    </div>
                    <h3 class="card-title">Turmas</h3>
                    <p class="card-desc">Gerencie as turmas, anos letivos e turnos da escola.</p>
                    <div class="card-link-text">
                        Acessar módulo <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>

            <div class="col-md-6 col-lg-4 col-xl-3">
                <a href="/professores" class="module-card theme-indigo">
                    <div class="icon-box">
                        <i class="bi bi-person-badge"></i>
                    </div>
                    <h3 class="card-title">Professores</h3>
                    <p class="card-desc">Cadastro de docentes e informações de contato.</p>
                    <div class="card-link-text">
                        Acessar módulo <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>

            <div class="col-md-6 col-lg-4 col-xl-3">
                <a href="/materias" class="module-card theme-purple">
                    <div class="icon-box">
                        <i class="bi bi-journal-bookmark"></i>
                    </div>
                    <h3 class="card-title">Matérias</h3>
                    <p class="card-desc">Disciplinas, carga horária e atribuição de aulas.</p>
                    <div class="card-link-text">
                        Acessar módulo <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>

            <div class="col-md-6 col-lg-4 col-xl-3">
                <a href="/grade" class="module-card theme-green">
                    <div class="icon-box">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </div>
                    <h3 class="card-title">Grade Geral</h3>
                    <p class="card-desc">Visualização completa e geração automática da grade.</p>
                    <div class="card-link-text">
                        Acessar módulo <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>

            <div class="col-md-6 col-lg-4 col-xl-3">
                <a href="/professores/acessorapido" class="module-card theme-orange">
                    <div class="icon-box">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h3 class="card-title">Agenda Docente</h3>
                    <p class="card-desc">Consulta rápida de aulas do dia e semana.</p>
                    <div class="card-link-text">
                        Acessar módulo <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>

            <div class="col-md-6 col-lg-4 col-xl-3">
                <a href="/usuario/index" class="module-card theme-teal">
                    <div class="icon-box">
                        <i class="bi bi-people"></i>
                    </div>
                    <h3 class="card-title">Usuários</h3>
                    <p class="card-desc">Controle de acesso e cadastro de administradores.</p>
                    <div class="card-link-text">
                        Acessar módulo <i class="bi bi-arrow-right"></i>
                    </div>
                </a>
            </div>

        </div>
    </div>

</body>
</html>