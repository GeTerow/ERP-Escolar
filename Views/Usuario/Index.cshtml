@model List<TaskWeb.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
    var nomeUsuario = Context.Session.GetString("Nome") ?? "Usuário";
    var primeiroNome = nomeUsuario.Split(' ')[0];
    
    string GetIniciais(string nome) {
        if (string.IsNullOrWhiteSpace(nome)) return "?";
        var parts = nome.Trim().Split(' ');
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper();
    }
    
    string GetColorClass(int id) {
        var colors = new[] { "teal", "cyan", "green", "blue", "indigo" };
        return colors[id % colors.Length];
    }
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet" />
    <style>
        /* Header Global */
        .navbar {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.75rem 0;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .navbar-brand {
            font-weight: 700;
            color: #4f46e5 !important;
            font-size: 1.25rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .avatar-user {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.9rem;
            color: white;
        }
        
        .bg-teal { background-color: #14b8a6; }
        .bg-cyan { background-color: #06b6d4; }
        .bg-green { background-color: #10b981; }
        .bg-blue { background-color: #3b82f6; }
        .bg-indigo { background-color: #6366f1; }

        .btn-teal {
            background-color: #14b8a6;
            border-color: #14b8a6;
            color: white;
        }
        .btn-teal:hover {
            background-color: #0d9488;
            border-color: #0d9488;
            color: white;
        }
    </style>
</head>
<body class="bg-light">
    
    <nav class="navbar sticky-top mb-5">
        <div class="container">
            <a class="navbar-brand" href="/home">
                <i class="bi bi-grid-1x2-fill"></i>
                Sistema de Grade
            </a>
            <div class="d-flex align-items-center gap-3">
                <div class="d-none d-sm-block text-muted small">
                    Olá, <strong>@primeiroNome</strong>
                </div>
                <a href="/usuario/logout" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Sair</a>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold text-dark mb-1">Controle de Acesso</h1>
                <p class="text-muted mb-0">Gerencie os usuários administradores do sistema.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="/home" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Voltar
                </a>
                <a href="/usuario/create" class="btn btn-teal">
                    <i class="bi bi-person-plus-fill me-1"></i> Novo Usuário
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success d-flex align-items-center shadow-sm border-0 mb-4 rounded-3">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i> <div>@TempData["Success"]</div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center shadow-sm border-0 mb-4 rounded-3">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> <div>@TempData["Error"]</div>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-0">
                
                @if (Model.Count == 0)
                {
                    <div class="text-center py-5">
                        <div class="mb-3">
                            <div class="bg-light d-inline-flex p-4 rounded-circle text-muted">
                                <i class="bi bi-people fs-1"></i>
                            </div>
                        </div>
                        <h5 class="fw-bold text-dark">Nenhum usuário encontrado</h5>
                        <a href="/usuario/create" class="btn btn-teal mt-3">Cadastrar Usuário</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light border-bottom">
                                <tr>
                                    <th class="ps-4 py-3 text-muted text-uppercase small fw-bold">Usuário</th>
                                    <th class="py-3 text-muted text-uppercase small fw-bold">Email de Acesso</th>
                                    <th class="pe-4 py-3 text-end text-muted text-uppercase small fw-bold" style="width: 150px;">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var usuario in Model)
                                {
                                    var iniciais = GetIniciais(usuario.Nome);
                                    var cor = GetColorClass(usuario.UsuarioId);
                                    
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-user bg-@cor me-3">
                                                    @iniciais
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-dark">@usuario.Nome</div>
                                                    <div class="small text-muted">ID: @usuario.UsuarioId</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="text-muted"><i class="bi bi-envelope me-2"></i>@usuario.Email</span>
                                        </td>
                                        <td class="pe-4 py-3 text-end">
                                            <a href="/usuario/edit/@usuario.UsuarioId" class="btn btn-sm btn-outline-primary border-0" title="Editar">
                                                <i class="bi bi-pencil-square fs-6"></i>
                                            </a>
                                            <a href="/usuario/delete/@usuario.UsuarioId" class="btn btn-sm btn-outline-danger border-0" title="Excluir">
                                                <i class="bi bi-trash fs-6"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>