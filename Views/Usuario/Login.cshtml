@model TaskWeb.Models.LoginViewModel

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Grade Escolar</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
        }

        .login-container {
            min-height: 100vh;
            background: #fff;
            overflow: hidden;
        }

        /* Lado Esquerdo - O Gradiente Roxo */
        .login-brand-section {
            background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%); /* Roxo forte */
            color: white;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 4rem;
            text-align: center;
        }

        /* Decoração de fundo */
        .login-decoration {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
        }
        .deco-1 { width: 300px; height: 300px; top: -50px; left: -50px; }
        .deco-2 { width: 400px; height: 400px; bottom: -100px; right: -100px; }

        /* Lado Direito - O Formulário */
        .login-form-section {
            padding: 3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: white;
        }

        .login-form-wrapper {
            width: 100%;
            max-width: 400px;
        }

        /* Inputs Bonitos */
        .form-control {
            padding: 0.8rem 1rem;
            border-radius: 0.5rem;
            border: 1px solid #d1d5db;
        }
        
        .form-floating > label {
            padding-top: 0.8rem;
        }

        /* Botão */
        .btn-login {
            background-color: #4f46e5;
            color: white;
            font-weight: 600;
            padding: 0.8rem;
            border-radius: 0.5rem;
            width: 100%;
            border: none;
            transition: 0.3s;
        }
        .btn-login:hover {
            background-color: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }
    </style>
</head>
<body>

    <div class="container-fluid p-0">
        <div class="row g-0 login-container">
            
            <div class="col-md-6 d-none d-md-flex login-brand-section">
                <div class="login-decoration deco-1"></div>
                <div class="login-decoration deco-2"></div>
                
                <div style="z-index: 2;">
                    <i class="bi bi-mortarboard-fill display-1 mb-4"></i>
                    <h1 class="fw-bold display-5">Grade Escolar</h1>
                    <p class="lead mt-3 text-white-50">
                        Gestão acadêmica inteligente e eficiente.
                    </p>
                </div>
            </div>

            <div class="col-md-6 login-form-section">
                <div class="login-form-wrapper">
                    
                    <div class="text-center d-md-none mb-4">
                        <i class="bi bi-mortarboard-fill text-primary display-1"></i>
                        <h2 class="fw-bold mt-2">ERP Escolar</h2>
                    </div>

                    <div class="mb-5">
                        <h3 class="fw-bold">Bem-vindo de volta!</h3>
                        <p class="text-muted">Insira suas credenciais para acessar.</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@ViewBag.Error</div>
                        </div>
                    }

                    <form action="/usuario/login" method="POST">
                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="floatingInput" name="Email" placeholder="nome@exemplo.com" value="@(Model.Email ?? string.Empty)" required>
                            <label for="floatingInput">Email</label>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <input type="password" class="form-control" id="floatingPassword" name="Senha" placeholder="Senha" required>
                            <label for="floatingPassword">Senha</label>
                        </div>

                        <button type="submit" class="btn btn-login mb-4">
                            Entrar no Sistema
                        </button>
                    </form>

                    <div class="text-center text-muted small">
                        Ainda não tem acesso? Contate a secretaria.
                    </div>
                </div>
            </div>
            
        </div>
    </div>

</body>
</html>