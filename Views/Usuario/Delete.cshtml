@model TaskWeb.Models.Usuario

@{
    ViewData["Title"] = "Excluir Usuário";
    
    string GetIniciais(string nome) {
        if (string.IsNullOrWhiteSpace(nome)) return "?";
        var parts = nome.Trim().Split(' ');
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[parts.Length - 1].Substring(0, 1)).ToUpper();
    }
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet" />
    <style>
        .avatar-delete {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 600;
            color: white;
            margin: 0 auto 1.5rem auto;
            background-color: #14b8a6; /* Teal para combinar */
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
        
        .card-delete {
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
            border-top: 5px solid #ef4444; /* Topo Vermelho de perigo */
        }
    </style>
</head>
<body class="bg-light">
    
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                
                <div class="card card-delete p-4">
                    <div class="card-body text-center">
                        
                        <div class="avatar-delete">
                            @GetIniciais(Model.Nome)
                        </div>

                        <h4 class="fw-bold text-dark mb-2">Remover Acesso?</h4>
                        <p class="text-muted mb-4">
                            Você está prestes a excluir o usuário <strong>@Model.Nome</strong>. Ele perderá o acesso ao sistema imediatamente.
                        </p>

                        <div class="bg-light rounded-3 p-3 mb-4 text-start">
                            <div class="d-flex align-items-center justify-content-center text-center">
                                <div>
                                    <div class="small text-uppercase fw-bold text-muted">Email de Login</div>
                                    <div class="fw-semibold text-dark">@Model.Email</div>
                                </div>
                            </div>
                        </div>

                        <form action="/usuario/delete" method="POST">
                            <input type="hidden" name="id" value="@Model.UsuarioId" />
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-danger btn-lg rounded-3 fw-semibold">
                                    <i class="bi bi-trash me-2"></i>Confirmar Exclusão
                                </button>
                                <a href="/usuario/index" class="btn btn-light text-muted fw-semibold">Cancelar</a>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
    
</body>
</html>